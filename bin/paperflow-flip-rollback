#!/usr/bin/env bash
# paperflow-flip-rollback — the one-move undo for paperflow-flip-to-tasks.
#
# Reads ~/.paperflow/flip-rollback.env (written by the flip's Phase 3 + 5) and:
#   1. Removes the bd symlink the flip created (BD_SYMLINK) — IF it still points
#      at our bd-shim. Removing it restores the original bd on PATH (ORIG_BD_PATH
#      reappears). We never delete a bd that isn't our symlink.
#   2. Restores each store's core.hooksPath from the recorded HOOKS_<repokey>
#      lines (git config core.hooksPath <value>).
#   3. Removes the .beads/FROZEN markers in each known store.
#
# Idempotent: missing symlink, missing env, already-restored hooks, and missing
# markers are all no-ops that report cleanly and exit 0. Import is intentionally
# NOT reversed — re-import is idempotent (barkpark skips existing docs), so the
# correct undo is "flip the substrate back, leave the mirrored docs."
#
# MODES
#   (default)   apply the rollback against the real system.
#   --dry-run   print what it WOULD do, touch nothing. (Used by tests.)
#
# rollback-env format (KEY=value, one per line):
#   ORIG_BD_PATH=/opt/homebrew/bin/bd      # informational — what reappears
#   BD_SYMLINK=/Users/x/.local/bin/bd      # the symlink we remove
#   HOOKS_<repokey>=<path>                 # per store, prior core.hooksPath
#
# Exit: 0 always on a clean rollback (incl. no-op) · 2 on a genuine error.

set -euo pipefail

PF_DIR="${PAPERFLOW_DIR:-$HOME/.paperflow}"
ROLLBACK_ENV="${PAPERFLOW_FLIP_ROLLBACK_ENV:-$PF_DIR/flip-rollback.env}"

DEFAULT_REPOS="$HOME/Documents/github/paperflow
/Volumes/SATECHI/github/barkpark"
FLIP_REPOS="${PAPERFLOW_FLIP_REPOS:-$DEFAULT_REPOS}"

DRY=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY=1 ;;
        -h|--help)
            sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *) printf 'unknown flag: %s\n' "$arg" >&2
           printf 'usage: paperflow-flip-rollback [--dry-run]\n' >&2
           exit 2 ;;
    esac
done

mkdir -p "$PF_DIR" 2>/dev/null || true
LOG="$PF_DIR/flip-rollback-$(date +%s).log"
: > "$LOG" 2>/dev/null || true
_log() { printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" "$*" >> "$LOG" 2>/dev/null || true; }
say()  { printf '%s\n' "$*"; _log "$*"; }

# Read a KEY's value from the rollback env. Empty if absent.
env_get() {
    [ -f "$ROLLBACK_ENV" ] || { printf ''; return 0; }
    line="$(grep -m1 "^$1=" "$ROLLBACK_ENV" 2>/dev/null || true)"
    printf '%s' "${line#*=}"
}

repo_key() { printf '%s' "$1" | tr '/.' '__'; }

say "paperflow-flip-rollback — $( [ "$DRY" = 1 ] && echo DRY-RUN || echo APPLY )"
say "rollback-env: $ROLLBACK_ENV"

if [ ! -f "$ROLLBACK_ENV" ]; then
    say "No rollback env found — nothing was flipped (or it was already rolled back)."
    say "Nothing to do. Exiting 0."
    exit 0
fi

# ── 1. Remove the bd symlink (restores original bd on PATH) ────────────
say ""
say "[1/3] bd symlink removal"
BD_SYMLINK="$(env_get BD_SYMLINK)"
ORIG_BD="$(env_get ORIG_BD_PATH)"
if [ -z "$BD_SYMLINK" ]; then
    say "  no BD_SYMLINK recorded — skipping (nothing to remove)"
elif [ -L "$BD_SYMLINK" ]; then
    target="$(readlink "$BD_SYMLINK" 2>/dev/null || true)"
    case "$target" in
        */bd-shim)
            if [ "$DRY" = 1 ]; then
                say "  DRY-RUN would run: rm -f $BD_SYMLINK   (→ restores $ORIG_BD on PATH)"
            else
                rm -f "$BD_SYMLINK"
                say "  removed symlink $BD_SYMLINK (was → $target)"
                say "  original bd restored on PATH: ${ORIG_BD:-<none>}"
                _log "removed bd symlink $BD_SYMLINK → $target"
            fi
            ;;
        *)
            say "  $BD_SYMLINK is a symlink to '$target' (NOT bd-shim) — leaving untouched"
            ;;
    esac
elif [ -e "$BD_SYMLINK" ]; then
    say "  $BD_SYMLINK exists but is not a symlink — leaving untouched (not ours)"
else
    say "  $BD_SYMLINK already absent — no-op"
fi

# ── 2. Restore core.hooksPath per store ────────────────────────────────
say ""
say "[2/3] core.hooksPath restore"
printf '%s\n' "$FLIP_REPOS" | tr ' ' '\n' | while IFS= read -r r; do
    [ -n "$r" ] || continue
    rk="$(repo_key "$r")"
    want="$(env_get "HOOKS_${rk}")"
    if [ -z "$want" ]; then
        say "  $r : no recorded hooksPath — skipping (was stock, or not flipped)"
        continue
    fi
    cur="$(git -C "$r" config --get core.hooksPath 2>/dev/null || echo '')"
    if [ "$cur" = "$want" ]; then
        say "  $r : already restored to $want — no-op"
        continue
    fi
    if [ "$DRY" = 1 ]; then
        say "  DRY-RUN would run: git -C $r config core.hooksPath $want   (current: ${cur:-<unset>})"
    else
        if git -C "$r" config core.hooksPath "$want" 2>/dev/null; then
            say "  $r : restored core.hooksPath → $want"
            _log "restored hooksPath $r → $want"
        else
            say "  WARN: could not restore core.hooksPath for $r"
            _log "WARN restore-failed hooksPath $r"
        fi
    fi
done

# ── 3. Remove FROZEN markers ───────────────────────────────────────────
say ""
say "[3/3] FROZEN marker removal"
printf '%s\n' "$FLIP_REPOS" | tr ' ' '\n' | while IFS= read -r r; do
    [ -n "$r" ] || continue
    marker="$r/.beads/FROZEN"
    if [ -f "$marker" ]; then
        if [ "$DRY" = 1 ]; then
            say "  DRY-RUN would run: rm -f $marker"
        else
            rm -f "$marker" && say "  removed $marker" || say "  WARN: could not remove $marker"
            _log "removed marker $marker"
        fi
    else
        say "  $marker already absent — no-op"
    fi
done

say ""
if [ "$DRY" = 1 ]; then
    say "DRY-RUN complete — nothing changed."
else
    say "Rollback complete. (Mirrored barkpark docs left in place — re-import is idempotent.)"
    say "The rollback-env is preserved at $ROLLBACK_ENV for audit; delete it to forget the flip."
fi
exit 0
