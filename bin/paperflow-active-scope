#!/usr/bin/env bash
# paperflow-active-scope — resolve which active-goal/active-phase pointer
# files belong to *this* paperflow instance. Cmux workspace first, Claude
# session second, unscoped legacy fallback last.
#
# Subcommands:
#   --resolve            print scope token: cmux-<wsid> | session-<sid> | unscoped
#   --read goal|phase    print scoped pointer (with unscoped fallback on miss)
#   --write goal|phase <id>   write scoped pointer
#   --clear              remove both pointers for current scope (not unscoped)
#   --list-all           JSON map of every scope's pointer pair
#   --migrate-legacy     copy unscoped → current-scope pointers (preserve legacy)
#   --validate goal|phase     verify scoped pointer exists in barkpark (W7c)
#   --migrate-bd-to-doc       reserved for the post-W7d UUID flip (currently a noop)
#   --help               this text
#
# Exit codes: 0 ok · 1 empty pointer · 2 args / drift · 3 fatal write.
#
# ── Pointer-namespace invariant (W7c) ──────────────────────────────────
# Pointer files hold bd-id strings (e.g. "paperflow-7r9"). Under the
# current dual-write substrate (W7c), barkpark stores the SAME string in
# its `doc_id` column when paperflow-mirror writes a goal/phase document.
# So the pointer's value IS the barkpark doc_id — there is no namespace
# translation today. The post-W7d flip will keep this invariant.
#
# When PAPERFLOW_MIRROR_GOALS=1 + PAPERFLOW_BARKPARK_URL set,
# `--validate` round-trips the pointer through barkpark to surface drift
# (pointer set locally but the doc was never mirrored / was deleted).
# When the mirror env is unset, `--validate` exits 0 silently — the daily
# driver remains validation-free.

set -eu

PF_DIR="${PAPERFLOW_DIR:-$HOME/.paperflow}"
SCOPE_CACHE="$PF_DIR/scope-of-pid-$$"
trap 'rm -f "$SCOPE_CACHE" 2>/dev/null || true' EXIT

usage() {
  cat <<'EOF'
Usage: paperflow-active-scope <subcommand> [args]

  --resolve              print current scope token (cmux-<wsid> | session-<sid> | unscoped)
  --read goal|phase      print active goal/phase id for current scope (with unscoped fallback)
  --write goal|phase ID  write scoped pointer for current scope
  --clear                clear scoped pointers for current scope (legacy untouched)
  --list-all             JSON of every scope's {goal, phase}
  --migrate-legacy       copy unscoped pointers into current scope (one-shot)
  --validate goal|phase  verify scoped pointer exists in barkpark (W7c, gated on PAPERFLOW_MIRROR_GOALS=1)
  --migrate-bd-to-doc    reserved for post-W7d UUID flip — currently a noop
                         (doc_id == bd-id in the W7c substrate)
  --help                 show this text

Pointer-namespace invariant:
  Pointer values are bd-ids today. Barkpark documents are keyed by the same
  string in their doc_id column under the W7c dual-write substrate. There is
  no translation table; --validate just round-trips the pointer through
  barkpark to surface drift when the mirror env is set.

Examples:
  paperflow-active-scope --resolve
  paperflow-active-scope --read goal
  PAPERFLOW_MIRROR_GOALS=1 PAPERFLOW_BARKPARK_URL=http://localhost:4001 \
    paperflow-active-scope --validate goal
EOF
}

# Detect the current paperflow scope. Order of precedence:
#   1. $CMUX_WORKSPACE_ID (+ optional $CMUX_SURFACE_REF) — exported by
#      cmux at shell spawn, stable per-session. Preferred.
#   2. cmux identify CLI — focused-workspace query, may drift between
#      calls if user changes focus. Fallback when env not set.
#   3. $CLAUDE_SESSION_ID — fallback when not running under cmux.
#   4. "unscoped" — single-machine, single-user mode.
_detect_scope() {
  # Preferred path: env vars set at shell spawn are stable per-session.
  # `cmux identify` queries currently-focused workspace, which can drift
  # between consecutive calls if the user changes focus.
  if [ -n "${CMUX_WORKSPACE_ID:-}" ]; then
    local ws_safe="${CMUX_WORKSPACE_ID//[\/:.]/-}"
    if [ -n "${CMUX_SURFACE_REF:-}" ]; then
      local sf_safe="${CMUX_SURFACE_REF//[\/:.]/-}"
      printf 'cmux-%s-%s' "$ws_safe" "$sf_safe"
    else
      printf 'cmux-%s' "$ws_safe"
    fi
    return 0
  fi
  local cmux="/Applications/cmux.app/Contents/Resources/bin/cmux"
  if [ -x "$cmux" ] || command -v cmux >/dev/null 2>&1; then
    [ -x "$cmux" ] || cmux="$(command -v cmux)"
    local out=""
    if command -v gtimeout >/dev/null 2>&1; then
      out="$(gtimeout 0.5 "$cmux" identify 2>/dev/null || true)"
    else
      out="$("$cmux" identify 2>/dev/null </dev/null & cmux_pid=$!; ( sleep 0.5; kill -9 "$cmux_pid" 2>/dev/null ) & guard_pid=$!; wait "$cmux_pid" 2>/dev/null; kill -9 "$guard_pid" 2>/dev/null || true)" || true
    fi
    if [ -n "$out" ]; then
      local wsref=""
      if command -v jq >/dev/null 2>&1; then
        wsref="$(printf '%s' "$out" | jq -r '.focused.workspace_ref // empty' 2>/dev/null || true)"
      else
        wsref="$(printf '%s' "$out" | sed -n 's/.*"workspace_ref"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
      fi
      if [ -n "$wsref" ]; then
        printf 'cmux-%s' "$(printf '%s' "$wsref" | tr ':' '-')"
        return 0
      fi
    fi
  fi
  if [ -n "${CLAUDE_SESSION_ID:-}" ]; then
    printf 'session-%s' "$CLAUDE_SESSION_ID"
    return 0
  fi
  printf 'unscoped'
}

_resolve() {
  if [ -r "$SCOPE_CACHE" ]; then
    cat "$SCOPE_CACHE"
    return 0
  fi
  mkdir -p "$PF_DIR" 2>/dev/null || true
  local s; s="$(_detect_scope)"
  printf '%s' "$s" > "$SCOPE_CACHE" 2>/dev/null || true
  printf '%s' "$s"
}

_path_for() { # kind, scope
  local kind="$1" scope="$2"
  if [ "$scope" = "unscoped" ]; then
    printf '%s/active-%s' "$PF_DIR" "$kind"
  else
    printf '%s/active-%s-%s' "$PF_DIR" "$kind" "$scope"
  fi
}

cmd_resolve() { _resolve; printf '\n'; }

cmd_read() {
  local kind="${1:-}"
  case "$kind" in goal|phase) ;; *) echo "usage: --read goal|phase" >&2; exit 2 ;; esac
  local scope; scope="$(_resolve)"
  local p; p="$(_path_for "$kind" "$scope")"
  local val=""
  [ -r "$p" ] && val="$(head -n1 "$p" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$val" ]; then printf '%s\n' "$val"; return 0; fi
  if [ "$scope" != "unscoped" ]; then
    local legacy; legacy="$(_path_for "$kind" "unscoped")"
    [ -r "$legacy" ] && val="$(head -n1 "$legacy" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "$val" ]; then printf '%s\n' "$val"; return 0; fi
  fi
  printf ''
  exit 1
}

cmd_write() {
  local kind="${1:-}" id="${2:-}"
  case "$kind" in goal|phase) ;; *) echo "usage: --write goal|phase <id>" >&2; exit 2 ;; esac
  [ -n "$id" ] || { echo "missing id" >&2; exit 2; }
  mkdir -p "$PF_DIR" 2>/dev/null || { echo "fatal: mkdir $PF_DIR" >&2; exit 3; }
  local scope; scope="$(_resolve)"
  local p; p="$(_path_for "$kind" "$scope")"
  printf '%s\n' "$id" > "$p" || { echo "fatal: write $p" >&2; exit 3; }

  # W7c: when the mirror is enabled, post-write probe barkpark to surface
  # drift early. Warning-only — barkpark might be down, or the goal/phase
  # might be created milliseconds later by paperflow-mirror-{goal,phase}
  # in a race with this write. The write itself always succeeds.
  if [ "${PAPERFLOW_MIRROR_GOALS:-0}" = "1" ] && [ -n "${PAPERFLOW_BARKPARK_URL:-}" ]; then
    _validate_pointer "$kind" "$id" "warn" || true
  fi
}

cmd_clear() {
  local scope; scope="$(_resolve)"
  [ "$scope" = "unscoped" ] && return 0
  rm -f "$(_path_for goal "$scope")" "$(_path_for phase "$scope")" 2>/dev/null || true
}

# _validate_pointer <kind> <id> <mode>
#   mode = "warn" → log to stderr but always exit 0
#   mode = "strict" → exit 2 on drift, exit 0 on found
#
# Sources lib/barkpark-mirror.sh on demand so the helper has zero impact
# on the daily-driver no-env path (the file isn't even read).
_validate_pointer() {
  local kind="$1" id="$2" mode="${3:-strict}"
  # If the env gates aren't set, both validate paths short-circuit to 0.
  if [ "${PAPERFLOW_MIRROR_GOALS:-0}" != "1" ] || [ -z "${PAPERFLOW_BARKPARK_URL:-}" ]; then
    return 0
  fi
  # Locate the mirror lib next to this script (../lib/barkpark-mirror.sh).
  local self_dir lib
  self_dir="$(cd "$(dirname "$0")" && pwd)"
  lib="$self_dir/../lib/barkpark-mirror.sh"
  if [ ! -r "$lib" ]; then
    # Fall back to PAPERFLOW_LIB_DIR or a sibling install-time location.
    lib="${PAPERFLOW_LIB_DIR:-$HOME/.paperflow/lib}/barkpark-mirror.sh"
  fi
  if [ ! -r "$lib" ]; then
    if [ "$mode" = "strict" ]; then
      echo "validate: barkpark-mirror.sh not found (mirror lib missing)" >&2
      exit 2
    fi
    return 0
  fi
  # shellcheck disable=SC1090
  . "$lib"
  if ! command -v barkpark_doc_exists >/dev/null 2>&1; then
    if [ "$mode" = "strict" ]; then
      echo "validate: barkpark_doc_exists not loaded" >&2
      exit 2
    fi
    return 0
  fi
  # set -e is active for the whole script — bare-call would propagate
  # the helper's non-zero rc and exit the script silently before the
  # case branch can emit the drift message. Capture via `|| rc=$?`.
  local rc=0
  barkpark_doc_exists "$kind" "$id" || rc=$?
  case "$rc" in
    0) [ "$mode" = "warn" ] || return 0 ;;
    1) # mirror disabled inside the helper — treat as no-op
       return 0 ;;
    2) # drift — pointer set but doc absent / wrong kind
       if [ "$mode" = "warn" ]; then
         echo "warn: pointer $kind=$id not found in barkpark ($PAPERFLOW_BARKPARK_URL) — drift" >&2
         return 0
       fi
       echo "drift: pointer $kind=$id not found in barkpark ($PAPERFLOW_BARKPARK_URL)" >&2
       exit 2 ;;
    3) # unreachable — be lenient even in strict mode (barkpark may be
       # down; the daily driver still works). Stay quiet in warn mode.
       if [ "$mode" = "strict" ]; then
         echo "warn: barkpark unreachable at $PAPERFLOW_BARKPARK_URL — skipping validate" >&2
       fi
       return 0 ;;
    *) if [ "$mode" = "strict" ]; then
         echo "validate: unexpected exit $rc from barkpark_doc_exists" >&2
         exit 2
       fi
       return 0 ;;
  esac
}

cmd_validate() {
  local kind="${1:-}"
  case "$kind" in goal|phase) ;; *) echo "usage: --validate goal|phase" >&2; exit 2 ;; esac
  # When the env isn't set we are a silent no-op (daily-driver invariant).
  if [ "${PAPERFLOW_MIRROR_GOALS:-0}" != "1" ] || [ -z "${PAPERFLOW_BARKPARK_URL:-}" ]; then
    return 0
  fi
  local scope; scope="$(_resolve)"
  local p; p="$(_path_for "$kind" "$scope")"
  local val=""
  [ -r "$p" ] && val="$(head -n1 "$p" 2>/dev/null | tr -d '[:space:]')"
  if [ -z "$val" ] && [ "$scope" != "unscoped" ]; then
    local legacy; legacy="$(_path_for "$kind" "unscoped")"
    [ -r "$legacy" ] && val="$(head -n1 "$legacy" 2>/dev/null | tr -d '[:space:]')"
  fi
  if [ -z "$val" ]; then
    echo "validate: no $kind pointer set for scope $scope" >&2
    exit 1
  fi
  _validate_pointer "$kind" "$val" "strict"
}

cmd_migrate_bd_to_doc() {
  # Reserved for the post-W7d substrate flip, where barkpark may begin
  # issuing UUIDs as the primary doc_id and bd-ids become a secondary
  # column. Today the two namespaces are unified (doc_id == bd-id under
  # the W7c dual-write substrate), so this subcommand is a deliberate
  # noop — present so callers can probe the existence/behaviour ahead of
  # the flip without environment branching.
  echo "noop: doc_id == bd-id in current substrate (W7c) — no migration needed"
  return 0
}

cmd_list_all() {
  mkdir -p "$PF_DIR" 2>/dev/null || true
  # Collect scope tokens from existing files.
  local tokens=""
  local f base
  for f in "$PF_DIR"/active-goal-* "$PF_DIR"/active-phase-*; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in
      active-goal-*)  tokens="$tokens
${base#active-goal-}" ;;
      active-phase-*) tokens="$tokens
${base#active-phase-}" ;;
    esac
  done
  [ -e "$PF_DIR/active-goal" ] || [ -e "$PF_DIR/active-phase" ] && tokens="$tokens
unscoped"
  # De-dup.
  tokens="$(printf '%s\n' "$tokens" | awk 'NF && !seen[$0]++')"
  # Emit JSON.
  printf '{\n'
  local first=1 g p tok
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    g="$(head -n1 "$(_path_for goal "$tok")" 2>/dev/null | tr -d '[:space:]' || true)"
    p="$(head -n1 "$(_path_for phase "$tok")" 2>/dev/null | tr -d '[:space:]' || true)"
    if [ $first -eq 0 ]; then printf ',\n'; fi
    first=0
    # Quote tok safely (no embedded quotes expected — scope tokens are alnum+dashes).
    printf '  "%s": {\n    "goal": "%s",\n    "phase": "%s"\n  }' "$tok" "${g:-}" "${p:-}"
  done <<EOF
$tokens
EOF
  printf '\n}\n'
}

cmd_migrate_legacy() {
  local scope; scope="$(_resolve)"
  if [ "$scope" = "unscoped" ]; then
    echo "Nothing to migrate (current scope is unscoped)"
    return 0
  fi
  local moved=0 g="" p=""
  local lg lp tg tp
  lg="$(_path_for goal unscoped)"
  lp="$(_path_for phase unscoped)"
  tg="$(_path_for goal "$scope")"
  tp="$(_path_for phase "$scope")"
  if [ -s "$lg" ] && [ ! -e "$tg" ]; then
    cp "$lg" "$tg" && moved=1 && g="$(head -n1 "$tg" | tr -d '[:space:]')"
  fi
  if [ -s "$lp" ] && [ ! -e "$tp" ]; then
    cp "$lp" "$tp" && moved=1 && p="$(head -n1 "$tp" | tr -d '[:space:]')"
  fi
  if [ "$moved" -eq 1 ]; then
    echo "Migrated ${scope}: goal=${g} phase=${p}"
  else
    echo "Nothing to migrate"
  fi

  # Scan for orphan cmux-style pointers from the old cmux-identify code
  # path (e.g. active-goal-cmux-workspace-3). Those are pre-2026-05 file
  # names that don't match the current UUID-shape scope. We never auto-
  # migrate them — the mapping from friendly name to UUID isn't knowable
  # — but we surface them so the user can rename or delete manually.
  local orphans=""
  local f base suffix hyphens
  for f in "$PF_DIR"/active-goal-cmux-* "$PF_DIR"/active-phase-cmux-*; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in
      active-goal-*)  suffix="${base#active-goal-}"  ;;
      active-phase-*) suffix="${base#active-phase-}" ;;
      *) continue ;;
    esac
    [ "$suffix" = "$scope" ] && continue
    # UUID-shape scopes have 4 hyphens in the cmux-<UUID> portion.
    # Anything with fewer is old-shape (cmux-workspace-N etc.).
    hyphens="$(printf '%s' "$suffix" | tr -cd '-' | wc -c | tr -d ' ')"
    if [ "$hyphens" -lt 4 ]; then
      orphans="$orphans  $base ($(head -n1 "$f" 2>/dev/null | tr -d '[:space:]'))
"
    fi
  done
  if [ -n "$orphans" ]; then
    printf '\nOrphan cmux-style pointers (old cmux-identify code path, harmless):\n%s' "$orphans"
    echo "  To migrate one: paperflow-active-scope --write goal <id> (writes to current scope)."
    echo "  To delete:      rm \$HOME/.paperflow/active-{goal,phase}-cmux-<old-name>"
  fi
}

# ── Dispatch ───────────────────────────────────────────────────────
case "${1:-}" in
  --resolve)           cmd_resolve ;;
  --read)              shift; cmd_read "${1:-}" ;;
  --write)             shift; cmd_write "${1:-}" "${2:-}" ;;
  --clear)             cmd_clear ;;
  --list-all)          cmd_list_all ;;
  --migrate-legacy)    cmd_migrate_legacy ;;
  --validate)          shift; cmd_validate "${1:-}" ;;
  --migrate-bd-to-doc) cmd_migrate_bd_to_doc ;;
  --help|-h|"")        usage ;;
  *) echo "unknown subcommand: $1" >&2; usage >&2; exit 2 ;;
esac
