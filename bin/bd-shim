#!/usr/bin/env node
// bd-shim — paperflow's bd-CLI-compatible wrapper that translates a subset
// of `bd` invocations into HTTP calls against Barkpark's /v1/tasks surface
// (the W7b step 1 controller, paperflow-rx0). Unknown subcommands fall
// through to the real `bd` on PATH, so this shim is non-disruptive when
// the orchestrator uses a command it does not (yet) wrap.
//
// SCOPE — what this translates today:
//   bd create "<title>" [--type epic|task] [--label X]* [--description D]
//                        [--priority N] [--parent <id>]               (#2)
//   bd show <id> --json
//   bd list [--label X] [--status Y] [--type T] --json
//   bd ready [--label phase-X] --json
//   bd update <id> --claim
//   bd update <id> --close [--reason …]
//   bd close <id> [--reason …]                                        (#2)
//   bd update <id> --add-label <label> [--remove-label <label>]   (tt5)
//   bd dep add <child> <parent>
//   bd epic close <id>
//   bd epic close-eligible --json
//   bd-shim --version
//   bd-shim --selftest
//
// tt5: `--label <X>` on `bd list` now maps to the controller's `?label=`
// EXACT content.labels filter for any label that isn't phase-/kind: — this is
// what makes `bd list --label file-claim:<path>` (paperflow-claim-files) find
// the real holders instead of the whole task set.
//
// Anything else → spawn the real `bd` via PATH (skipping ourselves) so the
// shim is a drop-in that degrades gracefully.
//
// CONFIG:
//   BARKPARK_URL   default http://localhost:4000
//   BARKPARK_TOKEN default barkpark-dev-token
//
// SHAPE CONTRACT:
//   The barkpark controller returns
//     { ok: true,  doc: <render_doc>, docs: [<render_doc>...] }
//   The bd-shim translates each `render_doc` into the bd-show / bd-list JSON
//   shape (`{ id, title, status, type, kind, content, labels[], assignee,
//   ts_created, ts_updated, dependencies: {children, parents} }`) so a
//   consumer parsing real bd's stdout sees byte-compatible JSON.
//   For text commands (claim / close / dep add / epic close), the shim
//   prints `✓ Updated issue: <id> — <title>` so consumers grepping on `^✓`
//   continue to work.

"use strict";

const http = require("http");
const https = require("https");
const url = require("url");
const { spawn, spawnSync } = require("child_process");
const path = require("path");

const VERSION = "0.1.0";

const BARKPARK_URL = process.env.BARKPARK_URL || "http://localhost:4000";
const BARKPARK_TOKEN = process.env.BARKPARK_TOKEN || "barkpark-dev-token";
const WORKER_ID = process.env.BD_SHIM_WORKER_ID || "bd-shim";

// ────────────────────────────────────────────────────────────────────────
// Entry
// ────────────────────────────────────────────────────────────────────────

function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0) {
    return forwardToRealBd(argv);
  }

  const first = argv[0];
  if (first === "--version" || first === "-V") return cmdVersion();
  if (first === "--selftest") return cmdSelftest();
  if (first === "--help" || first === "-h") return cmdHelp();

  // Top-level: create | show | list | ready | update | dep | close | epic
  switch (first) {
    case "create":
      return cmdCreate(argv.slice(1));
    case "show":
      return cmdShow(argv.slice(1));
    case "list":
      return cmdList(argv.slice(1));
    case "ready":
      return cmdReady(argv.slice(1));
    case "update":
      return cmdUpdate(argv.slice(1));
    case "dep":
      return cmdDep(argv.slice(1));
    case "close":
      // #2: bare `bd close <id>` previously fell through to the real local
      // bd (a SEPARATE Dolt store → split-brain). Route it to the same
      // close-by-id path as `bd update <id> --close`.
      return cmdClose(argv.slice(1));
    case "epic":
      return cmdEpic(argv.slice(1));
    default:
      return forwardToRealBd(argv);
  }
}

// ────────────────────────────────────────────────────────────────────────
// Built-ins
// ────────────────────────────────────────────────────────────────────────

function cmdVersion() {
  console.log(`bd-shim ${VERSION} → ${BARKPARK_URL}`);
  process.exit(0);
}

async function cmdSelftest() {
  try {
    const result = await httpJson("GET", "/v1/tasks/ready?limit=1");
    if (!result || result.ok !== true) {
      console.error(`selftest FAIL: unexpected payload ${JSON.stringify(result)}`);
      process.exit(2);
    }
    console.log(`selftest OK: ${BARKPARK_URL} → ${result.docs.length} ready docs`);
    process.exit(0);
  } catch (err) {
    console.error(`selftest FAIL: ${err.message}`);
    process.exit(2);
  }
}

function cmdHelp() {
  console.log(`bd-shim ${VERSION} — bd-compatible wrapper → Barkpark /v1/tasks
Pointing at: ${BARKPARK_URL}

Translated commands:
  bd create "<title>" [--type epic|task] [--label X]* [--description D] [--priority N] [--parent <id>]
  bd show <id> --json
  bd list [--label X] [--status Y] [--type T] --json
  bd ready [--label phase-X] --json
  bd update <id> --claim
  bd update <id> --close [--reason ...]
  bd close <id> [--reason ...]
  bd update <id> --add-label <label> [--remove-label <label>]
  bd dep add <child> <parent>
  bd epic close <id>
  bd epic close-eligible --json

Unknown subcommands fall through to the real \`bd\` on PATH.
Built-ins:  --version   --selftest   --help

Environment:
  BARKPARK_URL    override the Barkpark base URL (default http://localhost:4000)
  BARKPARK_TOKEN  override the auth token (default barkpark-dev-token)`);
  process.exit(0);
}

// ────────────────────────────────────────────────────────────────────────
// create (#2 — the split-brain fix)
// ────────────────────────────────────────────────────────────────────────

// `bd create "<title>" [--type epic|task] [--label X]* [--description D]
//  [--priority N] [--parent <id>]` → a Barkpark create mutation. WITHOUT this
// wrap, `bd create` fell through to the real local `bd` binary, which writes
// to a SEPARATE Dolt store — tasks created that way never reached Barkpark
// (the #2 split-brain). We translate to the same POST the e2e confirmed:
//
//   POST /v1/data/mutate/production
//   { "mutations": [ { "create": {
//       "_type": "goal|phase|task",
//       "doc_id": "<generated-or-derived>",       // NB: doc_id, NOT _id —
//       "title":  "<title>",                       // create_document reads
//       "content": { "kind": <type>, ... }         // doc_id; _id is ignored.
//   } } ] }
//
// Type/kind mapping (verified against tasks.ex validate_kind_content):
//   --type epic               → _type goal,  content.kind "goal"
//   --label kind:phase        → _type phase, content.kind "phase"
//   else                      → _type task,  content.kind "task"
//
// Per-kind REQUIRED content (validate_kind_content rejects the create otherwise):
//   goal:  goal_slug (non-empty string)         — derived from the title slug
//   phase: phase_name (non-empty string)        — derived from the title
//   task:  lifecycle_status ∈ open|in_progress|blocked|done|cancelled — "open"
//
// `--parent <id>` is stored as content.parent for goal/phase children and
// content.parent_id for work-tasks (the W7 hierarchy contract). We resolve the
// parent to its persisted doc_id (the "drafts." form) so the stored pointer
// matches what `bd ready --phase_id` / edges look up — bare parents would not
// match (verified live: phase_id filter is an exact match on the stored
// "drafts.<id>" parent_id).
async function cmdCreate(argv) {
  const { positional, flags } = parseArgs(argv);
  const title = positional[0];
  if (!title) return die('bd create: missing "<title>"');

  const labels = collectFlag(flags, "label");
  const hasPhaseKindLabel = labels.some((l) => String(l) === "kind:phase");

  // Resolve the bd `--type` + kind:phase label into the barkpark _type/kind.
  const bdType = typeof flags.type === "string" ? flags.type : null;
  let docType; // barkpark _type
  if (bdType === "epic") docType = "goal";
  else if (hasPhaseKindLabel) docType = "phase";
  else docType = "task"; // bd's task/story/bug all ride the task lifecycle

  // Derive a stable doc_id from the title slug + a short random suffix so the
  // created id is human-recognisable AND collision-resistant. The caller's
  // create confirmation prints this id; `bd show <id>` then resolves it.
  const slug = slugify(title);
  const docId = `${slug || docType}-${randomSuffix()}`;

  // Assemble content per the kind contract. `labels` is free-form (the
  // validator ignores unknown keys); we always carry it so `bd list --label`
  // and `bd show .labels[]` find the row.
  const content = { kind: docType, labels };
  const priority = parsePriority(flags.priority);
  if (priority !== null) content.priority = priority;
  const description = typeof flags.description === "string" ? flags.description : null;
  if (description) content.description = description;

  // Resolve --parent to its persisted doc_id (the "drafts." form). Goal/phase
  // children pin content.parent; work-tasks pin content.parent_id.
  let parentResolved = null;
  if (typeof flags.parent === "string") {
    parentResolved = await resolveDocId(flags.parent);
  }

  if (docType === "goal") {
    content.goal_slug = slug || docId; // required, non-empty
  } else if (docType === "phase") {
    content.phase_name = title; // required, non-empty
    if (parentResolved) content.parent = parentResolved;
  } else {
    content.lifecycle_status = "open"; // required
    if (parentResolved) content.parent_id = parentResolved;
  }

  const mutation = {
    create: { _type: docType, doc_id: docId, title, content },
  };

  try {
    const res = await httpJson("POST", "/v1/data/mutate/production", {
      mutations: [mutation],
    });
    const result = (res && res.results && res.results[0]) || null;
    if (!result || !result.id) {
      return die(`bd create: unexpected mutate response ${JSON.stringify(res)}`);
    }
    // result.id is the persisted "drafts.<id>" form; strip the prefix so the
    // confirmation + the id consumers re-use is the bare paperflow-* id (what
    // `bd show <id>` / `bd dep add` then resolve). Real bd prints
    // `✓ Created issue: <id>`.
    const bareId = stripDraftsPrefix(result.id);
    console.log(`✓ Created issue: ${bareId} — ${title}`);
    process.exit(0);
  } catch (err) {
    return die(`bd create: ${err.message}`);
  }
}

// Lowercase, hyphen-separated, alnum-only slug (mirrors bd's id-from-title).
function slugify(s) {
  return String(s)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 40);
}

function randomSuffix() {
  return require("crypto").randomBytes(3).toString("hex");
}

// bd priorities are integers (0 = highest). Accept a numeric string; return
// null for absent/non-numeric so we don't stamp a bogus content.priority.
function parsePriority(v) {
  if (typeof v !== "string") return null;
  const n = parseInt(v, 10);
  return Number.isNaN(n) ? null : n;
}

// ────────────────────────────────────────────────────────────────────────
// show / list / ready
// ────────────────────────────────────────────────────────────────────────

async function cmdShow(argv) {
  const { positional } = parseArgs(argv);
  const id = positional[0];
  if (!id) return die("bd show: missing <id>");
  try {
    // w7-08: single roundtrip to the dedicated GET /v1/tasks/:doc_id.
    // Try the raw id first; if not found, try the persisted-doc-id form
    // (Barkpark's Content.upsert_document prefixes inserted ids with
    // "drafts." for the draft → published lifecycle). bd consumers don't
    // see / care about this prefix — they pass the bare paperflow-* id.
    const candidates = id.startsWith("drafts.") ? [id] : [id, `drafts.${id}`];
    let showRes = null;
    let resolvedId = null;
    for (const candidate of candidates) {
      try {
        const res = await httpJson("GET", `/v1/tasks/${encodeURIComponent(candidate)}`);
        if (res && res.ok) {
          showRes = res;
          resolvedId = candidate;
          break;
        }
      } catch (_) { /* try next candidate */ }
    }
    if (!showRes) return die(`bd show: not found (${id})`);

    const edgesRes = await httpJson(
      "GET",
      `/v1/tasks/${encodeURIComponent(resolvedId)}/edges?kind=all`
    ).catch(() => null);

    const docForRender = showRes.doc;
    const edges = {
      children: (edgesRes && edgesRes.dependents) || [],
      parents: (edgesRes && edgesRes.dependencies) || [],
    };

    // w7-08c: goals need an epic_* roll-up — total + closed counts across
    // the full child subtree (phases + their work-tasks). Fetch once via the
    // new list endpoint; only the goal branch consumes the result.
    let epicSummary = null;
    if (docForRender.type === "goal") {
      epicSummary = await fetchEpicSummary(resolvedId);
    }

    const bdShape = renderShowShape(docForRender, edges, epicSummary);
    // Real `bd show <id> --json` emits an ARRAY with one element (so jq
    // pipelines treat show and list/ready uniformly). Wrap to match.
    console.log(JSON.stringify([bdShape], null, 2));
    process.exit(0);
  } catch (err) {
    return die(`bd show: ${err.message}`);
  }
}

// Roll up a goal's subtree: count phases (children of the goal) and their
// work-tasks (children of each phase). Returns { total, closed } where
// closed counts rows with lifecycle_status ∈ done/cancelled.
async function fetchEpicSummary(goalId) {
  try {
    const phasesRes = await httpJson(
      "GET",
      `/v1/tasks?type=phase&phase_id=${encodeURIComponent(goalId)}`
    );
    const phases = (phasesRes && phasesRes.docs) || [];
    let total = phases.length;
    let closed = phases.filter((p) =>
      ["done", "cancelled"].includes(p.lifecycle_status)
    ).length;

    for (const phase of phases) {
      const tasksRes = await httpJson(
        "GET",
        `/v1/tasks?type=task&phase_id=${encodeURIComponent(phase.doc_id)}`
      );
      const tasks = (tasksRes && tasksRes.docs) || [];
      total += tasks.length;
      closed += tasks.filter((t) =>
        ["done", "cancelled"].includes(t.lifecycle_status)
      ).length;
    }
    return { total, closed };
  } catch (_) {
    // If the roll-up fetch fails, render with zeros — the show response
    // still succeeds (shape stays intact) and the error doesn't bubble.
    return { total: 0, closed: 0 };
  }
}

async function cmdList(argv) {
  const { flags } = parseArgs(argv);
  try {
    // w7-08c: server-side filtering via GET /v1/tasks (replaces the prior
    // "fetch ready --limit 1000 then client-side filter" path which only
    // saw the ready slice — no in-progress, no done, no phases, no goals).
    const qs = new URLSearchParams();

    // --label phase-<id>:        maps to controller's phase_id query
    // --label kind:<k>:          maps to controller's kind query
    // --label <anything-else>:   maps to controller's `label=` EXACT filter
    //   (tt5). This covers `file-claim:<path>` (paperflow-claim-files' file
    //   ownership labels) AND arbitrary tags like `goal-<slug>` — previously
    //   goal-/file-claim labels fell through unfiltered, which made
    //   `bd list --label file-claim:X` return the whole task set instead of
    //   only the holders. The controller's `?label=` runs a JSONB
    //   content.labels containment, the honest server-side filter.
    const labels = collectFlag(flags, "label");
    for (const label of labels) {
      const phaseId = labelToPhaseId(label);
      if (phaseId) {
        qs.set("phase_id", phaseId);
        continue;
      }
      const [k, v] = String(label).split(":");
      if (k === "kind" && v) {
        qs.set("kind", v);
        continue;
      }
      // tt5: arbitrary label → exact content.labels filter. URLSearchParams
      // single-key set is fine — claim-files queries one file-claim label per
      // `bd list` call. (Last-write-wins if multiple non-phase/non-kind labels
      // are passed; real bd ANDs them, but no current caller does that here.)
      qs.set("label", label);
    }
    if (flags.status) qs.set("lifecycle_status", flags.status);
    if (flags.type) qs.set("type", flags.type);
    if (flags.limit) qs.set("limit", flags.limit);

    const path = `/v1/tasks${qs.toString() ? `?${qs.toString()}` : ""}`;
    const result = await httpJson("GET", path);
    if (!result || !result.ok) return die("bd list: barkpark refused");
    const docs = result.docs || [];
    const out = docs.map((d) => renderListShape(d));
    console.log(JSON.stringify(out, null, 2));
    process.exit(0);
  } catch (err) {
    return die(`bd list: ${err.message}`);
  }
}

async function cmdReady(argv) {
  const { flags } = parseArgs(argv);
  try {
    // #5: route to GET /v1/tasks/ready (Barkpark's Tasks.ready/1 — the
    // DEP-AWARE queue). The previous path hit GET /v1/tasks?lifecycle_status=open
    // (the plain index), which is NOT dep-aware: it surfaced blocked tasks as
    // ready. Tasks.ready/1 excludes any task with an unsatisfied `blocks` edge
    // (target not `done`), which is the whole point of the W7a ready queue —
    // the shim must expose it. Verified live: a task B blocked on A is absent
    // from /v1/tasks/ready until A closes, then appears.
    const qs = new URLSearchParams();

    // --label scoping (R1). The ready controller (tasks_controller.ready/2)
    // accepts EXACTLY three query params — dataset, limit, phase_id — and
    // NOTHING else. There is no generic server-side label filter on the ready
    // queue. So labels split two ways:
    //
    //   * `phase-<id>`  → the `phase_id` query param. NOTE: the ready path uses
    //     Tasks.ready/1 → ready_query → maybe_filter_phase (tasks.ex), which is
    //     an EXACT match `content->>'parent_id' == ^phase_id` — it does NOT
    //     strip "drafts." (the prefix-agnostic c9e8315 fix is on the controller
    //     `index`/maybe_filter_parent path, a DIFFERENT endpoint the ready
    //     queue never touches). Work-tasks store parent_id in the persisted
    //     "drafts.<id>" form (cmdCreate resolves --parent through resolveDocId),
    //     so we must resolve the phase slug to that same persisted form here or
    //     the exact match finds nothing. Server-side filter, so dep-awareness
    //     is preserved.
    //
    //   * any OTHER label (e.g. a project tag `myproj`, `goal-<slug>`) → there
    //     is NO upstream ready filter for it, so we filter the returned ready
    //     rows CLIENT-SIDE by each task's `labels` array. The filter runs AFTER
    //     the dep-aware endpoint returns, so blocked tasks are still excluded —
    //     dep-awareness is preserved; we only narrow the already-ready set.
    //
    // PRIOR BUG (e2e residual R1): a non-phase `--label X` hit neither path —
    // labelToPhaseId returned null so phase_id was never set, and there was no
    // client-side fallback, so `bd ready --label X` returned the GLOBAL queue
    // unchanged (the identical-15-row symptom). The clientLabel branch is the
    // fix.
    const labels = collectFlag(flags, "label");
    let clientLabel = null;
    for (const label of labels) {
      const p = labelToPhaseId(label);
      if (p) {
        // Resolve the phase slug to its persisted doc_id (try bare, then
        // "drafts.") so the EXACT-match phase_id filter lands on the stored
        // parent_id. Same resolution cmdCreate used to stamp parent_id.
        const phaseId = await resolveDocId(p);
        qs.set("phase_id", phaseId);
      } else if (clientLabel === null) {
        // First non-phase label becomes the client-side filter. (No current
        // caller passes more than one non-phase label to `bd ready`; if one
        // ever does, real bd ANDs them — match that by ANDing client-side.)
        clientLabel = label;
      } else {
        clientLabel = [].concat(clientLabel, label);
      }
    }

    // `--limit` is safe server-side EXCEPT when a client-side label filter is
    // active: the server would truncate to `limit` BEFORE our filter runs and
    // silently drop matches past the cut. Defer the limit to the client side
    // in that case so the cap counts post-filter rows.
    const clientLabels = clientLabel === null ? [] : [].concat(clientLabel);
    if (flags.limit && clientLabels.length === 0) qs.set("limit", flags.limit);

    const path = `/v1/tasks/ready${qs.toString() ? `?${qs.toString()}` : ""}`;
    const result = await httpJson("GET", path);
    if (!result || !result.ok) return die("bd ready: barkpark refused");
    let docs = result.docs || [];
    if (clientLabels.length) {
      docs = docs.filter((d) => clientLabels.every((l) => docHasLabel(d, l)));
      if (flags.limit) {
        const n = parseInt(flags.limit, 10);
        if (!Number.isNaN(n)) docs = docs.slice(0, n);
      }
    }
    const out = docs.map((d) => renderListShape(d));
    console.log(JSON.stringify(out, null, 2));
    process.exit(0);
  } catch (err) {
    return die(`bd ready: ${err.message}`);
  }
}

// Does ready-doc `d` carry label `label`? Labels live on the top-level
// `labels` array (render_ready_doc surfaces content.labels there); fall back
// to content.labels for older serializations. False when neither is an array.
function docHasLabel(d, label) {
  if (!d) return false;
  const labels = Array.isArray(d.labels)
    ? d.labels
    : (d.content && Array.isArray(d.content.labels) ? d.content.labels : null);
  return Array.isArray(labels) && labels.indexOf(label) !== -1;
}

// ────────────────────────────────────────────────────────────────────────
// update (claim / close)
// ────────────────────────────────────────────────────────────────────────

async function cmdUpdate(argv) {
  const { positional, flags } = parseArgs(argv);
  const id = positional[0];
  if (!id) return die("bd update: missing <id>");

  if (flags.claim !== undefined) {
    try {
      // w7-08: targeted POST /v1/tasks/:doc_id/claim — same semantics as
      // bd's `update <id> --claim` (caller names the row). No listAll() walk;
      // the controller's Tasks.claim_by_id/3 carries the advisory lock + CAS
      // + epoch bump on that specific doc. Resolve the "drafts." prefix first:
      // claim_by_id's fetch is an EXACT doc_id match, so a bare id 404s (same
      // root cause as #4's dep-add). Mirror cmdShow/cmdDep's resolution.
      const resolvedId = await resolveDocId(id);
      const result = await httpJson(
        "POST",
        `/v1/tasks/${encodeURIComponent(resolvedId)}/claim`,
        { worker_id: WORKER_ID }
      );
      if (!result || result.ok !== true) {
        return die(`bd update --claim: ${result && result.reason}`);
      }
      printConfirm("Updated issue", result.doc);
      process.exit(0);
    } catch (err) {
      return die(`bd update --claim: ${err.message}`);
    }
  }

  if (flags.close !== undefined) {
    return closeById(id, "bd update --close");
  }

  // tt5: --add-label / --remove-label → POST /v1/tasks/<id>/labels.
  // Backs paperflow-claim-files: `claim` adds `file-claim:<path>` labels,
  // `release` removes them. Both flags may co-occur and may repeat; collect
  // each into an array and send one POST with {add, remove}.
  const addLabels = collectFlag(flags, "add-label");
  const removeLabels = collectFlag(flags, "remove-label");
  if (addLabels.length || removeLabels.length) {
    try {
      const body = {};
      if (addLabels.length) body.add = addLabels;
      if (removeLabels.length) body.remove = removeLabels;
      // Resolve the bare id to the persisted doc_id (barkpark prefixes
      // upserted ids with "drafts."). Mirror cmdShow's candidate walk so
      // `bd update <bare-id> --add-label` lands on the real row.
      const resolvedId = await resolveDocId(id);
      const result = await httpJson(
        "POST",
        `/v1/tasks/${encodeURIComponent(resolvedId)}/labels`,
        body
      );
      if (!result || result.ok !== true) {
        return die(`bd update --add-label/--remove-label: ${result && result.reason}`);
      }
      // Real bd prints `✓ Updated issue: <id> — <title>` on a label change;
      // paperflow-claim-files discards stdout (>/dev/null) but other
      // consumers grep on `^✓ Updated issue`. Keep the confirmation.
      printConfirm("Updated issue", result.doc);
      process.exit(0);
    } catch (err) {
      return die(`bd update --add-label/--remove-label: ${err.message}`);
    }
  }

  return die(
    "bd update: only --claim, --close, --add-label, --remove-label are wrapped (others passthrough)"
  );
}

// ────────────────────────────────────────────────────────────────────────
// close (bare `bd close <id>` — #2 split-brain + #3 claimed-task close)
// ────────────────────────────────────────────────────────────────────────

// Bare `bd close <id>` was NOT wrapped, so it fell through to the real local
// bd binary (a SEPARATE Dolt store → never reached Barkpark). Route it to the
// same close-by-id path as `bd update <id> --close`.
function cmdClose(argv) {
  const { positional } = parseArgs(argv);
  const id = positional[0];
  if (!id) return die("bd close: missing <id>");
  return closeById(id, "bd close");
}

// ────────────────────────────────────────────────────────────────────────
// dep add
// ────────────────────────────────────────────────────────────────────────

async function cmdDep(argv) {
  const sub = argv[0];
  if (sub !== "add") return forwardToRealBd(["dep", ...argv]);
  const child = argv[1];
  const parent = argv[2];
  if (!child || !parent) return die("bd dep add: missing <child> <parent>");
  try {
    // #4: the edge endpoint resolves from_id/to_id via find_task_by_doc_id,
    // which is an EXACT doc_id match — barkpark stores ids prefixed with
    // "drafts.", so bare ids 404 (verified live). cmdShow/cmdUpdate already
    // resolve the prefix; cmdDep did NOT. Resolve both ends to their persisted
    // doc_id (try bare, then drafts.) before POSTing. Mirrors resolveDocId.
    const [fromId, toId] = await Promise.all([
      resolveDocId(child),
      resolveDocId(parent),
    ]);
    const result = await httpJson("POST", "/v1/tasks/edges", {
      from_id: fromId,
      to_id: toId,
      kind: "blocks",
    });
    if (!result || result.ok !== true) {
      return die(`bd dep add: ${result && result.reason}`);
    }
    // Print the bare ids the caller passed (consumers reason in bare ids).
    console.log(
      `✓ Added dependency: ${stripDraftsPrefix(child)} → ${stripDraftsPrefix(parent)} (blocks)`
    );
    process.exit(0);
  } catch (err) {
    return die(`bd dep add: ${err.message}`);
  }
}

// ────────────────────────────────────────────────────────────────────────
// epic close / close-eligible
// ────────────────────────────────────────────────────────────────────────

async function cmdEpic(argv) {
  const sub = argv[0];
  if (sub === "close") {
    const id = argv[1];
    if (!id) return die("bd epic close: missing <id>");
    // #8: the old path used listAll() (GET /v1/tasks/ready) which only sees
    // open/blocked WORK-TASKS — it never surfaced the goal row, so `bd epic
    // close <goal>` 404'd. closeById resolves via GET /v1/tasks/:doc_id, which
    // the controller widened to all four W7 types (goal included), so the goal
    // is found regardless of its lifecycle. The barkpark close side is being
    // fixed in parallel to accept goal/phase close.
    return closeById(id, "bd epic close");
  }
  if (sub === "close-eligible") {
    // w7-08: server-side aggregator. Returns [doc_id, …] of every goal whose
    // full child-subtree (phases + work-tasks) is closed. Real `bd epic
    // close-eligible --json` prints the doc_id list as a JSON array.
    try {
      const result = await httpJson("GET", "/v1/tasks/epic/close-eligible");
      if (!result || result.ok !== true) {
        return die(`bd epic close-eligible: ${result && result.reason}`);
      }
      console.log(JSON.stringify(result.doc_ids || [], null, 2));
      process.exit(0);
    } catch (err) {
      return die(`bd epic close-eligible: ${err.message}`);
    }
  }
  return forwardToRealBd(["epic", ...argv]);
}

// ────────────────────────────────────────────────────────────────────────
// Helpers — args, HTTP, shaping, passthrough
// ────────────────────────────────────────────────────────────────────────

function parseArgs(argv) {
  const positional = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const name = a.slice(2);
      const next = argv[i + 1];
      const value = next && !next.startsWith("--") ? next : true;
      if (next && !next.startsWith("--")) i++;
      // w7-08c: repeated flags accumulate into an array — real bd allows
      // `--label A --label B` and consumers grep on the union. The single-
      // value path stays the common case (flags.x === "scalar" still works).
      if (Object.prototype.hasOwnProperty.call(flags, name)) {
        flags[name] = [].concat(flags[name], value);
      } else {
        flags[name] = value;
      }
    } else {
      positional.push(a);
    }
  }
  return { positional, flags };
}

// Normalize one flag entry to an array — `flags.label` may be a scalar
// (single occurrence) or an array (repeated). Always returns an array.
function collectFlag(flags, name) {
  const v = flags[name];
  if (v === undefined) return [];
  return Array.isArray(v) ? v : [v];
}

// Translate a `phase-<id>` label into the controller's phase_id query param.
// Real bd labels in paperflow are e.g. `phase-build-a1b2`, mapped 1:1 to the
// W7 `content.parent_id` string. Any label that doesn't start with `phase-`
// returns null — callers fall through to a label-keyed in-memory filter.
function labelToPhaseId(label) {
  if (typeof label !== "string") return null;
  if (!label.startsWith("phase-")) return null;
  return label.slice("phase-".length);
}

function httpJson(method, pathStr, body) {
  return new Promise((resolve, reject) => {
    const parsed = url.parse(BARKPARK_URL);
    const isHttps = parsed.protocol === "https:";
    const client = isHttps ? https : http;
    const headers = {
      Authorization: `Bearer ${BARKPARK_TOKEN}`,
      Accept: "application/json",
    };
    let payload = null;
    if (body !== undefined && body !== null) {
      payload = JSON.stringify(body);
      headers["Content-Type"] = "application/json";
      headers["Content-Length"] = Buffer.byteLength(payload);
    }
    const req = client.request(
      {
        method,
        hostname: parsed.hostname,
        port: parsed.port || (isHttps ? 443 : 80),
        path: pathStr,
        headers,
      },
      (res) => {
        let buf = "";
        res.setEncoding("utf8");
        res.on("data", (chunk) => (buf += chunk));
        res.on("end", () => {
          try {
            const parsedJson = buf.length ? JSON.parse(buf) : null;
            if (res.statusCode >= 400) {
              return reject(
                new Error(
                  `HTTP ${res.statusCode}: ${
                    (parsedJson && (parsedJson.reason || parsedJson.message)) || buf
                  }`
                )
              );
            }
            resolve(parsedJson);
          } catch (e) {
            reject(new Error(`bad JSON from ${pathStr}: ${e.message}`));
          }
        });
      }
    );
    req.on("error", reject);
    if (payload) req.write(payload);
    req.end();
  });
}

// Pull every ready row — used by `bd list` only (which is naturally a
// list operation). `bd show` and `bd update --claim` use dedicated
// endpoints (w7-08) so the listAll waste is contained to list semantics.
async function listAll() {
  const result = await httpJson("GET", "/v1/tasks/ready?limit=1000");
  if (!result || !result.ok) return [];
  return result.docs;
}

// #3: close a task BY ID. The previous close path looked the row up via
// listAll() = GET /v1/tasks/ready?limit=1000, which EXCLUDES in_progress docs
// (the ready queue is open/blocked only) — so a CLAIMED task 404'd on close.
// Fix: resolve the row via GET /v1/tasks/:doc_id (finds in_progress docs, all
// four W7 types — w7-08a / widened in the controller), read its
// content.claim.epoch, then POST /v1/tasks/:doc_id/close with the observed
// epoch. Handles the "drafts." prefix the same way cmdShow does (try bare,
// then drafts.). Shared by `bd close <id>`, `bd update <id> --close`, and
// `bd epic close <id>`.
async function closeById(id, label) {
  try {
    const candidates = id.startsWith("drafts.") ? [id] : [id, `drafts.${id}`];
    let doc = null;
    let resolvedId = null;
    for (const candidate of candidates) {
      try {
        const res = await httpJson("GET", `/v1/tasks/${encodeURIComponent(candidate)}`);
        if (res && res.ok && res.doc) {
          doc = res.doc;
          resolvedId = doc.doc_id || candidate;
          break;
        }
      } catch (_) {
        /* try next candidate */
      }
    }
    if (!doc) return die(`${label}: not found (${id})`);

    // Epoch lives at content.claim.epoch; render_doc also surfaces it at the
    // top level as `claim`. A never-claimed row has no epoch — close still
    // needs an integer, so default to 1 (matches the close endpoint's
    // observed_epoch contract; a never-claimed row's CAS uses rev anyway).
    const claim =
      doc.claim || (doc.content && doc.content.claim) || null;
    const epoch = (claim && claim.epoch) || 1;

    const result = await httpJson(
      "POST",
      `/v1/tasks/${encodeURIComponent(resolvedId)}/close`,
      { worker_id: WORKER_ID, observed_epoch: epoch }
    );
    if (!result || result.ok !== true) {
      return die(`${label}: ${result && result.reason}`);
    }
    printConfirm("Updated issue", result.doc);
    process.exit(0);
  } catch (err) {
    return die(`${label}: ${err.message}`);
  }
}

// w7-08c (paperflow-y1c): shape-per-context renderers, replacing the
// previous single renderToBdShape/2. Real `bd` emits different top-level
// key sets depending on (a) the doc's `issue_type` and (b) whether the
// invocation is show vs list/ready. The Gate-B fidelity harness asserts
// the SHAPE — sorted top-level key set + per-key JSON type — of the shim's
// output matches each captured golden fixture; the split below is what
// makes that gate green.
//
// Two renderers:
//
//   renderShowShape(doc, edges, epicSummary?)
//     — full single-doc shape. Driven by `bd show <id> --json`. The shape
//       branches three ways:
//         goal/epic: id title status priority issue_type created_* labels
//                    updated_at dependents epic_closeable
//                    epic_closed_children epic_total_children
//                    (NO dependencies, NO parent, NO assignee/description/started_at,
//                     NO counts — goals don't carry the work-task metadata
//                     and bd represents their child-roll-up via epic_*.)
//         phase:     adds dependencies + dependents + parent (NO assignee/
//                    description/started_at, NO counts)
//         task:      adds dependencies + (when set) assignee/description/
//                    started_at (NO dependents, NO parent, NO counts)
//
//   renderListShape(doc)
//     — slimmer per-row shape for `bd list / bd ready --json`. Carries
//       dependency_count + dependent_count + comment_count (the server
//       hands these over on the response). For NON-GOAL rows, also
//       carries `dependencies` (empty array when no edges fetched —
//       the list endpoint does not bulk-fetch edges, matching real bd's
//       list output which inlines the dep list per row). For GOAL rows,
//       OMITS `dependencies` + `parent` + `assignee/description/started_at`
//       so list-type-epic shape matches real bd.
//
// Optional-when-present keys: `assignee` only when doc.assignee is set;
// `description` only when content.description is set; `started_at` only
// when the doc is in_progress (from content.claim.ts_iso); `parent` only
// for non-goal rows whose parent_id is set.

function renderShowShape(doc, edges, epicSummary) {
  const issueType = mapTypeToIssueType(doc.type);
  const isGoal = issueType === "epic";

  const base = {
    id: stripDraftsPrefix(doc.doc_id || doc.id),
    title: doc.title || "",
    status: doc.lifecycle_status || doc.status || "open",
    priority: doc.priority == null ? 0 : doc.priority,
    issue_type: issueType,
    created_at: doc.inserted_at || doc.created_at || null,
    created_by: doc.created_by || "bd-shim",
    updated_at: doc.updated_at || null,
    labels: doc.labels || [],
  };

  if (isGoal) {
    // Goal → bd "epic" show: epic_* roll-up + dependents (direct children).
    const total = (epicSummary && epicSummary.total) || 0;
    const closed = (epicSummary && epicSummary.closed) || 0;
    base.dependents = (edges && edges.children) || [];
    base.epic_closeable = total > 0 && closed === total;
    base.epic_closed_children = closed;
    base.epic_total_children = total;
    return base;
  }

  // Non-goal: dependencies always present (possibly empty).
  base.dependencies = (edges && edges.parents) || [];

  if (doc.type === "phase") {
    base.dependents = (edges && edges.children) || [];
    if (doc.parent) base.parent = stripDraftsPrefix(doc.parent);
    return base;
  }

  // Work-task: optional metadata only when populated.
  if (doc.assignee) base.assignee = doc.assignee;
  const startedAt = startedAtFor(doc);
  if (startedAt) base.started_at = startedAt;
  const description = (doc.content && doc.content.description) || doc.description;
  if (description) base.description = description;
  return base;
}

function renderListShape(doc) {
  const issueType = mapTypeToIssueType(doc.type);
  const isGoal = issueType === "epic";

  const out = {
    id: stripDraftsPrefix(doc.doc_id || doc.id),
    title: doc.title || "",
    status: doc.lifecycle_status || doc.status || "open",
    priority: doc.priority == null ? 0 : doc.priority,
    issue_type: issueType,
    created_at: doc.inserted_at || doc.created_at || null,
    created_by: doc.created_by || "bd-shim",
    updated_at: doc.updated_at || null,
    labels: doc.labels || [],
    // Server-supplied counts (w7-08c batch_edge_counts). Default 0 so
    // older responses without these keys don't drop fields silently.
    dependency_count: doc.dependency_count || 0,
    dependent_count: doc.dependent_count || 0,
    comment_count: doc.comment_count || 0,
  };

  if (isGoal) {
    // Goal list rows OMIT dependencies/parent/work-metadata — matches real
    // `bd list --type epic` shape (no dependencies array, no parent).
    return out;
  }

  // Non-goal: dependencies array is present in real bd list output.
  // The list endpoint doesn't bulk-fetch edges, so this is empty for now —
  // shape parity is what Gate-B asserts (key present + type "array").
  out.dependencies = [];

  // `parent` is a phase-only field in real bd list output. Tasks carry
  // their parent inside the `dependencies` array (as a parent-child entry);
  // they DO NOT get a top-level `parent` key. The captured list-all
  // fixture's element[0] is a task whose top-level keys explicitly omit
  // `parent`.
  if (doc.type === "phase" && doc.parent) {
    out.parent = stripDraftsPrefix(doc.parent);
  }

  if (doc.assignee) out.assignee = doc.assignee;
  const startedAt = startedAtFor(doc);
  if (startedAt) out.started_at = startedAt;
  const description = (doc.content && doc.content.description) || doc.description;
  if (description) out.description = description;
  return out;
}

// `started_at` is the bd-shape sibling of barkpark's `content.claim.ts_iso`
// — populated only while the doc is in_progress (which is when bd considers
// it "started"). Defensive: also accept doc.started_at if the server adds it
// directly later.
function startedAtFor(doc) {
  if (doc.started_at) return doc.started_at;
  const status = doc.lifecycle_status || doc.status;
  if (status !== "in_progress") return null;
  return (doc.claim && doc.claim.ts_iso) ||
    (doc.content && doc.content.claim && doc.content.claim.ts_iso) ||
    null;
}

// Resolve a bare id to the persisted doc_id barkpark actually stored. Upserts
// prefix ids with "drafts."; consumers pass the bare paperflow-* id. Probe the
// bare id first, fall back to the "drafts." form (mirrors cmdShow's candidate
// walk). Returns the form that resolves, or the original id if neither does
// (so the caller's POST surfaces a clean 404 instead of guessing).
async function resolveDocId(id) {
  const candidates = id.startsWith("drafts.") ? [id] : [id, `drafts.${id}`];
  for (const candidate of candidates) {
    try {
      const res = await httpJson("GET", `/v1/tasks/${encodeURIComponent(candidate)}`);
      if (res && res.ok) return candidate;
    } catch (_) {
      /* try next candidate */
    }
  }
  return id;
}

// Barkpark prefixes upserted doc_ids with "drafts." (the draft→published
// lifecycle is incidental to the bd-shim's consumers). Strip the prefix on
// output so `paperflow-7r9` round-trips intact through `bd show`.
function stripDraftsPrefix(id) {
  if (typeof id !== "string") return id;
  return id.startsWith("drafts.") ? id.slice("drafts.".length) : id;
}

// Real bd's `issue_type` is one of: epic, task, story, bug. Our W7 substrate
// uses `type` for the schema discriminator (goal/phase/task/event). Map:
//   goal  → epic   (matches paperflow's "Goals as Beads epics" convention)
//   phase → task   (phases ride the task lifecycle but live below the goal)
//   task  → task
//   event → task
function mapTypeToIssueType(type) {
  if (type === "goal") return "epic";
  return "task";
}

function printConfirm(verb, doc) {
  // Strip the "drafts." persistence prefix so the confirmation prints the
  // bare paperflow-* id (matches real bd's `✓ Updated issue: <id>` and the
  // ids the show/list shapes already emit).
  const id = stripDraftsPrefix((doc && (doc.doc_id || doc.id)) || "<unknown>");
  const title = (doc && doc.title) || "";
  console.log(`✓ ${verb}: ${id} — ${title}`);
}

function die(msg) {
  console.error(msg);
  process.exit(1);
}

// Forward to the REAL bd on PATH — but skip our own location to avoid an
// infinite loop if /this/ shim is what `which bd` resolves to (the
// installer in w7-12 will place a symlink, so the guard matters).
function forwardToRealBd(argv) {
  const real = findRealBd();
  if (!real) {
    console.error("bd-shim: no real `bd` found on PATH (unknown subcommand)");
    process.exit(127);
  }
  const child = spawn(real, argv, { stdio: "inherit" });
  child.on("exit", (code) => process.exit(code === null ? 1 : code));
  child.on("error", (err) => {
    console.error(`bd-shim: failed to exec real bd: ${err.message}`);
    process.exit(127);
  });
}

function findRealBd() {
  const selfRealPath = (() => {
    try {
      return require("fs").realpathSync(process.argv[1]);
    } catch {
      return process.argv[1];
    }
  })();
  const selfDir = path.dirname(selfRealPath);
  const pathEnv = process.env.PATH || "";
  const sep = process.platform === "win32" ? ";" : ":";
  const dirs = pathEnv.split(sep).filter(Boolean);
  for (const d of dirs) {
    const candidate = path.join(d, "bd");
    try {
      const real = require("fs").realpathSync(candidate);
      // Skip ourselves, and also skip any path inside our own directory —
      // the installer may symlink `bd` -> `bd-shim`.
      if (real === selfRealPath) continue;
      if (path.dirname(real) === selfDir && path.basename(real) === "bd-shim") continue;
      // Validate executable
      require("fs").accessSync(real, require("fs").constants.X_OK);
      return real;
    } catch {
      // not present or not executable — keep looking
    }
  }
  return null;
}

main();
